<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <FlowerInstallationLocationSource Condition="'$(FlowerInstallationLocationSource)' == ''">$(MSBuildThisFileDirectory)../../flower_control/drivers/high_helper/InstallationLocation.cs</FlowerInstallationLocationSource>
  </PropertyGroup>
  <ItemGroup><Compile Remove="InstallationLocation.cs" /><Compile Include="$(FlowerInstallationLocationSource)" Link="InstallationLocation.cs" /></ItemGroup>
</Project>
