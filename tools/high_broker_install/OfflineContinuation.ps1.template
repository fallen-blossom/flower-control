function RequirePersistentStop {
    foreach($record in @(@($plan.StopPath,$plan.StopSha256),@($plan.ComputerPath,$plan.ComputerSha256))) {
        [FlowerRecoveryProtection]::RequireProtectedFile($record[0])
        if((Hash $record[0]) -cne $record[1]) { throw 'continuation_stop_record_changed' }
    }
}
function RequireFixedStop {
    RequirePersistentStop
    $shared=[FlowerPinnedDelivery]::SnapshotWriteGate()
    if($shared[0] -ne 1 -or $shared[1] -ne $plan.SharedEpoch -or $shared[2] -ne $plan.ResumeAllEpoch) { throw 'continuation_shared_stop_changed' }
}
function RequireUpdateActors {
    if(!$retainClients) { RequireNoActors; return }
    if(![FlowerPinnedDelivery]::StoppedWriteFenceHeld()) { throw 'retained_clients_not_parked' }
    RequireFixedStop
    $running=@(Get-ScheduledTask | Where-Object {$_.TaskName.StartsWith('FlowerControl.',[StringComparison]::Ordinal) -and [string]$_.State -eq 'Running'})
    if($running.Count) { throw 'offline_flower_task_still_running' }
    foreach($fact in $plan.RetainedProcessFacts) {
        $current=[FlowerStoppedClientRetention]::Verify([int]$fact.Pid)
        if($null -eq $current -and $plan.RetainedHostPids -contains [int]$fact.Pid) { throw 'retained_host_exited' }
    }
    $versionsRoot=(Join-Path $brokerRoot 'versions')+'\'
    $knownNames=@($plan.VersionExecutableNames)
    $candidates=[Collections.Generic.HashSet[int]]::new()
    foreach($process in @(Get-CimInstance Win32_Process)) {
        $known=$knownNames -icontains $process.Name
        $inside=![string]::IsNullOrWhiteSpace($process.ExecutablePath) -and $process.ExecutablePath.StartsWith($versionsRoot,[StringComparison]::OrdinalIgnoreCase)
        if($known -or $inside) { $null=$candidates.Add([int]$process.ProcessId) }
    }
    foreach($process in [FlowerStoppedClientRetention]::ProcessNames()) {
        if($knownNames -icontains $process.Name) { $null=$candidates.Add([int]$process.Pid) }
    }
    foreach($candidatePid in $candidates) {
        $live=[FlowerStoppedClientRetention]::Read($candidatePid)
        if($null -eq $live -or !$live.Image.StartsWith($versionsRoot,[StringComparison]::OrdinalIgnoreCase)) { continue }
        if($plan.RetainedActorPids -notcontains [int]$live.Pid) { throw 'unparked_version_executor_present' }
        $null=[FlowerStoppedClientRetention]::Verify([int]$live.Pid)
    }
    RequireFixedStop
}
function RequirePausedInstalledStatus($response) {
    if($response.Phase -cne 'status') { throw 'continuation_status_phase_rejected' }
    $status=$response.Status; RequireStatusShape $status
    $ordinary=[int]$roleAnchor.Tier -le 0
    if($status.version -cne $version -or $status.session_id -ne $plan.SessionId -or
        $status.authority_tier -ne $roleAnchor.Tier -or $status.policy_revision -cne $roleAnchor.Revision -or
        $status.paused -ne $true -or $status.global_write_stopped -ne $true -or
        $status.global_stop_epoch -ne $plan.SharedEpoch -or $status.protected_stop_epoch -ne $plan.ProtectedEpoch -or
        $status.computer_paused -ne $plan.ComputerStopped -or $status.active_requests -ne 0 -or
        $status.stopping -ne $false -or $status.release_fault -ne $false -or $status.role_transition -ne $false -or
        $null -ne $status.stop_persistence_error -or $null -ne $status.computer_pause_persistence_error -or
        $status.high_verified -ne (!$ordinary) -or $status.ordinary_verified -ne $ordinary -or
        $status.broker_role -cne $(if($ordinary){'ordinary'}else{'high'}) -or $status.ui_access -ne $false) {
        throw 'continuation_paused_status_rejected'
    }
    # Admin's existing pipe handshake validates the exact server image. Recheck
    # its live kernel identity and token, including the ordinary bootstrap case.
    $server=[FlowerStoppedClientRetention]::Read([int]$status.pid)
    if($null -eq $server -or $server.Created -cne ([string]$status.created) -or $server.Image -ine $newExe -or
        $server.Session -ne $plan.SessionId -or $server.User -cne $plan.UserSid -or $server.UiAccess -or
        $server.Integrity -ne $(if($ordinary){8192}else{12288}) -or
        ![FlowerOfflineGuard]::HasHostWindow([int]$server.Pid)) { throw 'continuation_started_role_identity_rejected' }
    return $server
}
function CloseRetainedLedgerFence {
    if($null -eq $script:ledgerFence) { return }
    if(!$script:ledgerFence.Held) { throw 'continuation_ledger_fence_lost' }
    # Used for both successful and failed starts. Do not let a resume already
    # waiting at SQLite escape just because startup/status verification failed.
    if(![FlowerPinnedDelivery]::StoppedWriteFenceHeld()) {
        [FlowerPinnedDelivery]::EnterStoppedWriteFence([long]$plan.SharedEpoch,[long]$plan.ResumeAllEpoch)
    }
    $script:finalSharedEpoch=[FlowerPinnedDelivery]::AdvanceStoppedGeneration([long]$plan.SharedEpoch,[long]$plan.ResumeAllEpoch)
    $script:ledgerFence.Dispose();$script:ledgerFence=$null
    RequirePersistentStop
    $closed=[FlowerPinnedDelivery]::SnapshotWriteGate()
    if($closed[0] -ne 1 -or $closed[1] -ne $script:finalSharedEpoch -or $closed[2] -ne $plan.ResumeAllEpoch) {throw 'continuation_final_stop_unconfirmed'}
    Log 'legacy_waiting_resume_epoch_invalidated' @{previous_epoch=$plan.SharedEpoch;shared_epoch=$script:finalSharedEpoch;resume_all_epoch=$plan.ResumeAllEpoch;shared_mutex_held=$true;resumed=$false}
}
function CopyNewCandidateIfMissing {
    Assert-FlowerNoLinks $newDir -Shallow
    # Existing targets retain the original strict complete-version verification.
    # Never fill, overwrite or erase an unconfirmed partial target here.
    if([IO.Directory]::Exists($newDir)) { return $false }
    if($plan.PSObject.Properties.Name -notcontains 'CopyNewTarget' -or !$plan.CopyNewTarget) { throw 'continuation_existing_payload_required' }
    $hashes=@{}
    foreach($item in $newActive.hashes.PSObject.Properties) {$hashes.Add($item.Name,[string]$item.Value)}
    foreach($item in $newActive.runtime_hashes.PSObject.Properties) {$hashes.Add($item.Name.Replace('/','\'),[string]$item.Value)}
    foreach($item in $newPolicy.AppWorkerHashes.PSObject.Properties) {$hashes.Add(('app\'+$item.Name),[string]$item.Value)}
    foreach($item in $newPolicy.WgcWorkerHashes.PSObject.Properties) {$hashes.Add(('wgc\'+$item.Name),[string]$item.Value)}
    $hashes.Add('installation.json',$plan.ActiveSha256)
    foreach($relative in $hashes.Keys) {
        if([IO.Path]::IsPathRooted($relative) -or $relative.Contains(':') -or $relative.Contains('/') -or @($relative.Split('\')|Where-Object {$_ -in @('','.','..')}).Count) { throw 'payload_relative_path_rejected' }
    }
    RequireFixedStop; RequireUpdateActors; RequirePreviousTask
    [FlowerPinnedDelivery]::CreateNewVersionDirectory($newDir,$plan.UserSid)
    Set-FlowerProtection $newDir
    [FlowerPinnedDelivery]::PinDirectory($newDir)
    $count=0
    foreach($relative in @($hashes.Keys|Sort-Object)) {
        $destination=Join-Path $newDir $relative;$parent=[IO.Path]::GetDirectoryName($destination)
        $missing=New-Object 'System.Collections.Generic.Stack[string]'
        for($part=$parent;![IO.Directory]::Exists($part);$part=[IO.Path]::GetDirectoryName($part)) {$missing.Push($part)}
        while($missing.Count) {$part=$missing.Pop();[IO.Directory]::CreateDirectory($part)|Out-Null;Set-FlowerProtection $part}
        [FlowerPinnedDelivery]::CopyFile((Join-Path $sourceDir $relative),$destination,$hashes[$relative])
        Set-FlowerProtection $destination;$count++
        if($count % 128 -eq 0) {Write-Progress -Activity '正在自动复制新版文件；Codex 保持打开即可' -Status ($count.ToString()+'/'+$hashes.Count) -PercentComplete ([int](100*$count/$hashes.Count))}
    }
    Write-Progress -Activity '正在自动复制新版文件；Codex 保持打开即可' -Completed
    Log 'new_candidate_copied_without_overwrite' @{version=$version;files=$count;resumed=$false}
    return $true
}
function WaitForHostConnectionsToClose {
    $deadline=[Diagnostics.Stopwatch]::GetTimestamp()+600*[Diagnostics.Stopwatch]::Frequency
    Write-Host '新版文件已校验完成。现在请正常退出整个 Codex，让旧插件连接关闭。请保持 Codex 关闭，直到看到“安装换版完成”弹窗。最多等待十分钟。' -ForegroundColor Yellow
    do {
        try { RequireNoActors; return }
        catch {
            if($_.Exception.Message -cne 'offline_independent_executor_present') { throw }
            if([Diagnostics.Stopwatch]::GetTimestamp() -ge $deadline) { throw 'continuation_host_connections_not_closed' }
            RequireFixedStop; RequirePreviousTask
        }
    } while($true)
}
function ShowContinuationResult([bool]$Succeeded) {
    if($Succeeded) {
        $title='Flower Control：安装换版完成'
        $message='安装换版完成。现在可以重新打开 Codex，回原聊天核对实际服务和插件。Flower 保持停止状态；安装完成不代表功能测试已通过。'
        $icon=[System.Windows.Forms.MessageBoxIcon]::Information
    } else {
        $title='Flower Control：安装未完成'
        $message='安装未完成。现在可以重新打开 Codex，回原聊天检查本次错误。不要重跑这个入口，也不要手动恢复控制权限。'
        $icon=[System.Windows.Forms.MessageBoxIcon]::Error
    }
    [System.Windows.Forms.MessageBox]::Show($message,$title,[System.Windows.Forms.MessageBoxButtons]::OK,$icon) | Out-Null
}
