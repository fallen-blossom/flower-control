        # mutex held they cannot capture a newer epoch before ledger release.
        CloseRetainedLedgerFence
        Log 'installed_paused_verified' @{version=$version;pid=$server.Pid;created=$server.Created;broker_role=$(if([int]$roleAnchor.Tier -le 0){'ordinary'}else{'high'});shared_mutex_held=$true;shared_epoch=$finalSharedEpoch;status_sample_shared_epoch=$plan.SharedEpoch;resumed=$false}
    }
    $finalState=if($retainClients){'installed_paused_verified'}else{'installed_paused_status_pending'}
    Log $finalState @{version=$version;resumed=$false;original_exit_evidence_operation=$plan.OriginalExitEvidenceOperation;current_quiescence_verified=(!$retainClients);old_stdio_clients_retained=$retainClients}
    [IO.File]::WriteAllText(($prefix+'-result.json'),(@{schema=1;state=$finalState;version=$version;operation=$plan.OperationId;previous_operation=$plan.PreviousOperation;original_exit_evidence_operation=$plan.OriginalExitEvidenceOperation;current_quiescence_verified=(!$retainClients);old_stdio_clients_retained=$retainClients;resumed=$false;original_exit_code=0;journal_sha256=$plan.JournalSha256;shared_epoch=$finalSharedEpoch;status_sample_shared_epoch=$plan.SharedEpoch}|ConvertTo-Json -Depth 8),$utf8)
    Write-Host '安装换版完成，Flower 保持停止状态。接下来核对插件实际版本，再进行功能测试。'
    if(!$retainClients) { try { ShowContinuationResult $true } catch { Write-Warning '安装换版已完成。完成弹窗未能显示，现在可以重新打开 Codex 核对。' } }
    exit 0
} catch {
    $reason=$_.Exception.Message
    Log 'continuation_failed_no_resume' @{stage=$stage;reason=$reason;task_changed=$taskChanged;active_changed=$activeChanged;start_attempted=$startAttempted}
    if($script:LoggingReady) {[IO.File]::WriteAllText(($prefix+'-result.json'),(@{schema=1;state='failed';stage=$stage;reason=$reason;operation=$plan.OperationId;version=$version;task_changed=$taskChanged;active_changed=$activeChanged;start_attempted=$startAttempted;resumed=$false}|ConvertTo-Json -Depth 8),$utf8)}
    Write-Error $reason -ErrorAction Continue
    if(!$retainClients) { try {
        Add-Type -AssemblyName System.Windows.Forms
        ShowContinuationResult $false
    } catch { Write-Warning '安装未完成。现在可以重新打开 Codex 检查错误；不要重跑入口。' } }
    exit 1
} finally {
    try {
        try { CloseRetainedLedgerFence }
        catch {
            if($script:LoggingReady) {
                Log 'continuation_cleanup_stop_unconfirmed' @{stage=$stage;resumed=$false;stop_confirmed=$false}
                [IO.File]::WriteAllText(($prefix+'-result.json'),(@{schema=1;state='failed';stage='cleanup_stop_unconfirmed';operation=$plan.OperationId;version=$version;resumed=$false;stop_confirmed=$false}|ConvertTo-Json -Depth 8),$utf8)
            }
            throw
        }
        finally { if($null -ne $guard) {$guard.Dispose()} }
    }
    finally {
        try { if('FlowerStoppedClientRetention' -as [type]) {[FlowerStoppedClientRetention]::Close()} }
        finally {
            try { if('FlowerPinnedDelivery' -as [type]) {[FlowerPinnedDelivery]::Close()} }
            finally { if($null -ne $script:ledgerFence) {$script:ledgerFence.Dispose()} }
        }
    }
}
