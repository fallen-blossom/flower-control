    Assert-FlowerTaskSecurity
    $newTask = Get-FlowerTask
    if (@($newTask.Actions).Count -ne 1 -or $newTask.Actions.Execute -ine $newExe -or $newTask.Actions.Arguments -cne '--serve' -or
        $newTask.Actions.WorkingDirectory -ine $newDir -or [string]$newTask.Principal.RunLevel -notin @('Highest', 'HighestAvailable') -or
        [string]$newTask.Principal.LogonType -notin @('Interactive', 'InteractiveToken')) { throw 'new_task_unconfirmed' }
    $script:NewTaskHash = HashText ([string](Export-ScheduledTask -TaskName $taskName -TaskPath '\'))
    $script:ActiveChanged = $true; ReplaceActive (Join-Path $package 'active.json') $plan.ActiveSha256 $plan.OldActiveSha256
    if ((HashText ([string](Export-ScheduledTask -TaskName $taskName -TaskPath '\'))) -cne $script:NewTaskHash -or
        (HashText (Get-FlowerTaskSecurityDescriptor)) -cne $plan.OldTaskSddlSha256) { throw 'new_task_changed_before_start' }
    if($leavePaused) {
        RequireLiveUpdateActors
        [FlowerPinnedDelivery]::CloseInputs()
        [FlowerPinnedDelivery]::ExitStoppedWriteFence()
    }
    $script:StartAttempted = $true
    Start-ScheduledTask -TaskName $taskName -TaskPath '\'
    $started = WaitReady $newExe $version
    RequireComputerPause $started $true
    if($leavePaused) {
        $finalStatus=CompleteLivePausedUpdate $started
        # Cleanup may absorb a newer user Stop. Only our exact maintenance
        # generation may be released; the native CAS checks it once more.
        if ($restoreRunning -and $script:FinalSharedEpoch -eq ($maintenanceShared + 1)) {
            FinalizeLiveUpdateResources
            $script:LiveResourcesFinalized = $true
            $finalStatus = ResumeBroker $newExe $finalStatus $true $script:FinalSharedEpoch
            $script:Resumed = $true
            Log 'installed_and_running' @{version=$version;shared_epoch=$script:FinalSharedEpoch;resumed=$true}
            [IO.File]::WriteAllText(($prefix + '-result.json'), (@{schema=1;state='installed_and_running';version=$version;operation=$plan.OperationId;resumed=$true;shared_epoch=$script:FinalSharedEpoch;protected_epoch=($maintenanceProtected+1);after=$finalStatus} | ConvertTo-Json -Depth 10),$utf8)
            exit 0
        }
        Log 'installed_paused_verified' @{version=$version;shared_epoch=$script:FinalSharedEpoch;resumed=$false}
        [IO.File]::WriteAllText(($prefix + '-result.json'), (@{schema=1;state='installed_paused_verified';version=$version;operation=$plan.OperationId;resumed=$false;shared_epoch=$script:FinalSharedEpoch;protected_epoch=$maintenanceProtected;after=$finalStatus} | ConvertTo-Json -Depth 10),$utf8)
        exit 0
    }
    $after = ResumeBroker $newExe $started $true
    $script:Resumed = $true
    Log 'installed_and_running' @{ version = $version; pid = $after.pid; operation = $plan.OperationId }
    [IO.File]::WriteAllText(($prefix + '-result.json'), ([ordered]@{ schema = 1; state = 'installed_and_running'; version = $version;
        previous_version = $oldVersion; operation = $plan.OperationId; after = $after; semantic_newly_enabled = $false } | ConvertTo-Json -Depth 10), $utf8)
    exit 0
} catch {
    $reason = $_.Exception.Message
    if($leavePaused) { [FlowerPinnedDelivery]::ExitStoppedWriteFence() }
    try { $rollback = Rollback } catch {$rollback='manual_recovery_required';[Console]::Error.WriteLine('rollback_diagnostic_unavailable')}
    try { Log 'failed' @{ reason = $reason; rollback = $rollback } } catch {[Console]::Error.WriteLine('failed_log_unavailable')}
    if ($script:LoggingReady) {
        [IO.File]::WriteAllText(($prefix + '-result.json'), ([ordered]@{ schema = 1; state = 'failed'; reason = $reason;
            rollback = $rollback; version = $version; operation = $plan.OperationId; final_shared_epoch = $script:FinalSharedEpoch; active_changed = $script:ActiveChanged; task_changed = $script:TaskChanged; start_attempted = $script:StartAttempted; resumed = $script:Resumed; resume_attempted = $script:ResumeAttempted; resume_outcome_unknown = ($script:ResumeAttempted -and !$script:Resumed) } | ConvertTo-Json -Depth 8), $utf8)
    }
    exit 1
} finally {
    if($script:WriterMarkerReady) {
        try {
            $script:WriterMarker.State='closed'
            [IO.File]::WriteAllText((Join-Path ([IO.Path]::GetDirectoryName($prefix)) 'maintenance-writer.json'),($script:WriterMarker|ConvertTo-Json -Compress),$utf8)
        } catch {[Console]::Error.WriteLine('maintenance_writer_close_unconfirmed')}
    }
    if($leavePaused -and !$script:LiveResourcesFinalized) {FinalizeLiveUpdateResources}
    elseif('FlowerPinnedDelivery' -as [type]) {[FlowerPinnedDelivery]::Close()}
}
