function RequirePreviousTask {
    if ((HashText ([string](Export-ScheduledTask -TaskName $taskName -TaskPath '\'))) -cne $plan.OldTaskDefinitionSha256 -or
        (HashText (Get-FlowerTaskSecurityDescriptor)) -cne $plan.OldTaskSddlSha256) { throw 'old_task_definition_changed' }
}
function RequireReleasedJournal([switch]$AllowMissing) {
    $path = $plan.RecoveryJournal
    Assert-FlowerNoLinks $path -Shallow
    if ($null -eq ('FlowerOfflineJournalMetadata' -as [type])) {
        Add-Type -TypeDefinition @'
using System;
using System.ComponentModel;
using System.Runtime.InteropServices;
public static class FlowerOfflineJournalMetadata {
    [DllImport("kernel32.dll",CharSet=CharSet.Unicode,SetLastError=true)]
    static extern uint GetFileAttributesW(string path);
    public static bool Missing(string path) {
        uint attributes=GetFileAttributesW(path);
        if(attributes!=uint.MaxValue) return false;
        int error=Marshal.GetLastWin32Error();
        if(error!=2) throw new Win32Exception(error,"offline_journal_metadata_unreadable");
        return true;
    }
}
'@
    }
    # Only FILE_NOT_FOUND is absence. Access denied, a missing parent,
    # same-name directory or a partial atomic write is never an empty journal.
    if (![FlowerOfflineJournalMetadata]::Missing($path + '.new')) { throw 'offline_partial_journal_present' }
    if ([FlowerOfflineJournalMetadata]::Missing($path)) {
        if (!$AllowMissing) { throw 'offline_existing_journal_required' }
        return $null
    }
    if (!(Test-Path -LiteralPath $path -PathType Leaf)) { throw 'offline_journal_rejected' }
    $file = Get-Item -LiteralPath $path
    if ($file.Length -lt 1 -or $file.Length -gt 16777216) { throw 'offline_journal_rejected' }
    # New native startup remains the authoritative strict decoder. Here reject
    # any unconfirmed release; never acknowledge or erase historical results.
    $journal = [IO.File]::ReadAllText($path) | ConvertFrom-Json
    if ($journal.Schema -ne 1 -or $journal.PSObject.Properties.Name -notcontains 'Pending' -or
        $null -eq $journal.Pending -or $journal.Pending -isnot [array] -or $journal.Pending.Count -gt 4128) { throw 'offline_journal_rejected' }
    foreach ($item in $journal.Pending) {
        if ($item.InputRelease -cne 'released' -or $item.MutexReleased -isnot [bool] -or !$item.MutexReleased -or
            $item.NativeCountKnown -isnot [bool] -or !$item.NativeCountKnown -or
            $item.Acknowledged -isnot [bool] -or $item.Acknowledged -or
            ($null -ne $item.SemanticExecutorExited -and $item.SemanticExecutorExited -isnot [bool]) -or
            $item.PhysicalInputFree -isnot [bool] -or
            ($item.SemanticExecutorExited -eq $false -and $item.PhysicalInputFree -ne $true)) { throw 'offline_input_release_unconfirmed' }
    }
    return (Hash $path)
}
function RequireNoActors([ValidateRange(0, 600000)][int]$WaitMilliseconds = 15000) {
    $knownNames = @('Flower.HighHelper.exe', 'Flower.AppWorker.exe', 'flower-python.exe') +
        @($newPolicy.WgcWorkerHashes.PSObject.Properties.Name | Where-Object { [IO.Path]::GetExtension($_) -ieq '.exe' })
    if ($null -eq ('FlowerOfflineProcessMetadata' -as [type])) {
        Add-Type -TypeDefinition @'
using System;
using System.ComponentModel;
using System.IO;
using System.Runtime.InteropServices;
using System.Text;
using Microsoft.Win32.SafeHandles;
public static class FlowerOfflineProcessMetadata {
    [DllImport("kernel32.dll",SetLastError=true)]
    static extern SafeProcessHandle OpenProcess(uint access,bool inherit,int pid);
    [DllImport("kernel32.dll",SetLastError=true)]
    static extern uint WaitForSingleObject(SafeProcessHandle process,uint milliseconds);
    [DllImport("kernel32.dll",CharSet=CharSet.Unicode,SetLastError=true)]
    static extern bool QueryFullProcessImageNameW(SafeProcessHandle process,uint flags,StringBuilder path,ref uint length);
    static bool Exited(SafeProcessHandle process) {
        uint wait=WaitForSingleObject(process,0);
        if(wait==0) return true;
        if(wait==258) return false;
        throw new Win32Exception(Marshal.GetLastWin32Error(),"offline_process_wait_unreadable");
    }
    public static string LiveImage(int pid) {
        if(pid<=0) throw new IOException("offline_process_id_rejected");
        using(var process=OpenProcess(0x101000,false,pid)) {
            if(process.IsInvalid) {
                int error=Marshal.GetLastWin32Error();
                if(error==87) return null;
                throw new Win32Exception(error,"offline_process_open_unreadable");
            }
            if(Exited(process)) return null;
            var path=new StringBuilder(32768);uint length=(uint)path.Capacity;
            if(!QueryFullProcessImageNameW(process,0,path,ref length)) {
                int error=Marshal.GetLastWin32Error();
                if(Exited(process)) return null;
                throw new Win32Exception(error,"offline_process_image_unreadable");
            }
            if(Exited(process)) return null;
            if(path.Length==0) throw new IOException("offline_process_image_empty");
            return path.ToString();
        }
    }
}
'@
    }
    $versionsRoot = (Join-Path $brokerRoot 'versions') + '\'
    $deadline = [Diagnostics.Stopwatch]::GetTimestamp() + [long]($WaitMilliseconds * [Diagnostics.Stopwatch]::Frequency / 1000.0)
    $logged = $false
    $unreadableLogged = [Collections.Generic.HashSet[int]]::new()
    $pendingUnreadable = [Collections.Generic.HashSet[int]]::new()
    $trackedActors = [Collections.Generic.HashSet[int]]::new()
    $metadataRetried = $false
    do {
    $running = @(Get-ScheduledTask | Where-Object { $_.TaskName.StartsWith('FlowerControl.', [StringComparison]::Ordinal) -and [string]$_.State -eq 'Running' })
    if ($running.Count -ne 0) { throw 'offline_flower_task_still_running' }
    $candidates = [Collections.Generic.Dictionary[int,object]]::new()
    foreach ($candidate in @(Get-CimInstance Win32_Process)) {
        $known = $knownNames -icontains $candidate.Name
        $inside = ![string]::IsNullOrWhiteSpace($candidate.ExecutablePath) -and $candidate.ExecutablePath.StartsWith($versionsRoot, [StringComparison]::OrdinalIgnoreCase)
        if ($known -or $inside) { $candidates[[int]$candidate.ProcessId] = $candidate }
    }
    foreach ($pendingPid in $trackedActors) {
        if (!$candidates.ContainsKey($pendingPid)) {
            $candidates[$pendingPid] = [pscustomobject]@{ ProcessId = $pendingPid; Name = 'previously-unreadable'; ExecutablePath = $null }
        }
    }
    $actors = @($candidates.Values | ForEach-Object {
        $actorPid = [int]$_.ProcessId; $actorName = [string]$_.Name
        try { $image = [FlowerOfflineProcessMetadata]::LiveImage($actorPid) }
        catch {
            $errorCode = $null; $cause = $_.Exception.GetBaseException()
            if ($cause -is [ComponentModel.Win32Exception]) { $errorCode = $cause.NativeErrorCode }
            if ($unreadableLogged.Add($actorPid)) {
                Log 'actor_metadata_unreadable' @{ pid = $actorPid; name = $actorName.Substring(0, [Math]::Min(128, $actorName.Length)); phase = 'read_only_handle'; winerror = $errorCode }
            }
            # A process can lose query access during shutdown after the CIM
            # snapshot. Do not call it absent or reuse the stale snapshot.
            # Retry only access-denied within the original total wait budget;
            # a persistent unreadable process still prevents publication.
            if ($errorCode -ne 5) { throw 'offline_executor_path_unreadable' }
            $null = $pendingUnreadable.Add($actorPid)
            $null = $trackedActors.Add($actorPid)
            $metadataRetried = $true
            return
        }
        $null = $pendingUnreadable.Remove($actorPid)
        if ($null -eq $image -or !$image.StartsWith($versionsRoot, [StringComparison]::OrdinalIgnoreCase)) {
            $null = $trackedActors.Remove($actorPid)
            return
        }
        $null = $trackedActors.Add($actorPid)
        $mode = ''
        if ($null -ne $_.PSObject.Properties['CommandLine']) {
            $mode = [regex]::Match([string]$_.CommandLine, '(?:^|[\s"])(--[a-z][a-z0-9-]{1,48})(?=[\s"]|$)').Groups[1].Value
        }
        [pscustomobject]@{ pid = $actorPid; name = $actorName; image = $image; reported_mode_from_cim = $mode }
    })
    if ($actors.Count -eq 0 -and $pendingUnreadable.Count -eq 0 -and $trackedActors.Count -eq 0) {
        if ($metadataRetried) { Log 'executor_quiescence_verified_after_metadata_retry' @{ count = 0; unreadable = 0; fresh_scan = $true; input_dispatched = $false } }
        return
    }
    if (!$logged) {
        Log 'waiting_for_executor_quiescence' @{ count = $actors.Count; unreadable = $pendingUnreadable.Count; actors = @($actors | Select-Object -First 16); input_dispatched = $false }
        $logged = $true
    }
    if ([Diagnostics.Stopwatch]::GetTimestamp() -ge $deadline) {
        if ($pendingUnreadable.Count -ne 0) { throw 'offline_executor_path_unreadable' }
        throw 'offline_independent_executor_present'
    }
    # Hold the original singleton/input lease and Stop while observing natural
    # exit. No process is ignored, killed, acknowledged or resumed by this wait.
    Start-Sleep -Milliseconds 250
    } while ($true)
}
function RoleFileInventory {
    $root = Join-Path $brokerRoot 'recovery'; $name = $plan.UserSid + '.' + $plan.SessionId
    $paths = @((Join-Path $root ('stop\' + $name + '.json')), (Join-Path $root ('computer-pause\' + $name + '.json')))
    foreach ($kind in @('global', 'computer')) {
        $path = Join-Path $root ('ordinary-stop\' + $name + '.' + $kind + '.bin')
        $paths += $path; $paths += $path + '.ack.json'
    }
    $rows = @()
    foreach ($path in $paths) {
        Assert-FlowerNoLinks $path -Shallow
        $hash = $null
        if (![FlowerOfflineJournalMetadata]::Missing($path)) {
            if (!(Test-Path -LiteralPath $path -PathType Leaf)) { throw 'offline_role_record_rejected' }
            $hash = Hash $path
        }
        $rows += @{ path = $path; hash = $hash }
    }
    return ($rows | ConvertTo-Json -Depth 8 -Compress)
}
function RequireRoleAnchor {
    $current = Admin $newExe '--flower-role-policy'
    if ($current.Phase -cne 'role_policy' -or $current.UserSid -cne $plan.UserSid -or
        (HashText ($current | ConvertTo-Json -Depth 8 -Compress)) -cne $roleAnchorHash -or
        (HashText (RoleFileInventory)) -cne $roleFilesHash) { throw 'offline_role_or_stop_changed' }
    return $current
}
function VerifiedStopForRecovery {
    if ($journalAbsent) {
        if ($null -eq $roleFilesHash) { throw 'offline_recovery_absence_not_verified' }
        $current = RequireRoleAnchor
        if ($null -ne (RequireReleasedJournal -AllowMissing)) { throw 'offline_recovery_journal_changed' }
        return $current.Stop.Protected
    }
    return (Admin $newExe '--offline-update-state').Stop
}
function EnsureRecoveryProtection {
    $root = Join-Path $brokerRoot 'recovery'
    Assert-FlowerNoLinks $root -Shallow
    if (![IO.Directory]::Exists($root)) { throw 'offline_recovery_parent_unavailable' }
    try { [FlowerRecoveryProtection]::Ensure($root) }
    catch {
        $reason = $_.Exception.GetBaseException().Message
        if ($reason -cnotin @('recovery_high_label_missing', 'recovery_inheritance_missing')) { throw }
        # Legacy repair is retained only for a missing inheritable root label.
        # A modern root already has the correct protection. Its ordinary Stop
        # append records intentionally retain their existing Medium label.
        $repair = [FlowerRecoveryProtection]::TightenStopped($root)
        [FlowerRecoveryProtection]::Ensure($root)
        Log 'recovery_inheritance_repaired' $repair
        return
    }
    Log 'recovery_protection_verified' @{ existing_root = $true; legacy_repair_performed = $false }
}
function RecoverStoppedOriginal {
    # Before the old process exits, leave its exact installation in place.
    # A copied subset may be reused only after a fresh byte/ACL inventory.
    if (!$originalExited) { return 'original_not_replaced_payload_reusable' }
    # Start-ScheduledTask can time out after committing. Do not switch metadata
    # underneath a possibly running new process; the real host must inspect it.
    if ($startAttempted) { return 'new_start_outcome_requires_live_status' }
    if (!$stopLatched -or $null -eq $guard) { throw 'offline_recovery_stop_or_lease_missing' }
    $stop = VerifiedStopForRecovery
    if (!$stop.Stopped -or $stop.UserSid -cne $plan.UserSid -or $stop.Session -ne $plan.SessionId) { throw 'offline_recovery_stop_changed' }
    $currentTaskHash = HashText ([string](Export-ScheduledTask -TaskName $taskName -TaskPath '\'))
    if ((HashText (Get-FlowerTaskSecurityDescriptor)) -cne $plan.OldTaskSddlSha256) { throw 'offline_recovery_task_changed' }
    if ($currentTaskHash -cne $plan.OldTaskDefinitionSha256) {
        if (!$taskChanged -or $null -eq $publishedTaskHash -or $currentTaskHash -cne $publishedTaskHash) { throw 'offline_recovery_task_changed' }
    }
    $activeHash = Hash (Join-Path $brokerRoot 'active.json')
    if ($activeHash -cne $plan.OldActiveSha256) {
        if (!$activeChanged -or $activeHash -cne $plan.ActiveSha256) { throw 'offline_recovery_active_changed' }
    }
    # Validate both components before changing either one.
    if ($currentTaskHash -cne $plan.OldTaskDefinitionSha256) { RegisterTask $oldXml $oldSddl }
    if ($activeHash -cne $plan.OldActiveSha256) {
        ReplaceActive (Join-Path $oldDir 'installation.json') $plan.OldActiveSha256 $plan.ActiveSha256
    }
    RequirePreviousTask
    if ((Hash (Join-Path $brokerRoot 'active.json')) -cne $plan.OldActiveSha256) { throw 'offline_recovery_active_unconfirmed' }
    $stop = VerifiedStopForRecovery
    if (!$stop.Stopped -or $stop.UserSid -cne $plan.UserSid -or $stop.Session -ne $plan.SessionId) { throw 'offline_recovery_stop_changed' }
    $guard.Dispose(); $script:guard = $null
    Start-ScheduledTask -TaskName $taskName -TaskPath '\'
    return 'original_metadata_restored_stopped_start_submitted'
}
function ShowOfflineMigrationResult([bool]$Succeeded, [bool]$CleanupFailed = $false) {
    if($CleanupFailed) {
        $title='Flower Control：安装状态需要检查'
        $message='安装已进入收尾阶段，但资源释放发生错误。已有安装回执保留，请重新打开 Codex 核对实际版本与资源状态；不要重跑入口或恢复控制。'
        $icon=[System.Windows.Forms.MessageBoxIcon]::Error
    } elseif($Succeeded) {
        $title='Flower Control：安装换版完成'
        $message='安装换版完成。现在可以重新打开 Codex，回原聊天核对实际服务和插件。Flower 保持停止状态；安装完成不代表功能测试已通过。'
        $icon=[System.Windows.Forms.MessageBoxIcon]::Information
    } else {
        $title='Flower Control：安装未完成'
        $message='安装未完成。现在可以重新打开 Codex，回原聊天检查本次错误。不要重跑这个入口，也不要手动恢复控制权限。'
        $icon=[System.Windows.Forms.MessageBoxIcon]::Error
    }
    [System.Windows.Forms.MessageBox]::Show($message,$title,[System.Windows.Forms.MessageBoxButtons]::OK,$icon) | Out-Null
}

