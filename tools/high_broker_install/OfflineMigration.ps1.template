    $stage = 'offline_checks'
    RequirePreviousTask
    if ((Hash (Join-Path $brokerRoot 'active.json')) -cne $plan.OldActiveSha256) { throw 'offline_active_changed' }
    # Host-owned MCP connections remain alive after the tray exits. Wait for
    # normal host closure; every scan still requires zero actors, with no exemptions.
    RequireNoActors -WaitMilliseconds 600000
    $journalHash = RequireReleasedJournal -AllowMissing
    $journalAbsent = $null -eq $journalHash
    EnsureRecoveryProtection
    $currentRole = Admin $newExe '--flower-role-policy'
    if ((HashText ($currentRole | ConvertTo-Json -Depth 8 -Compress)) -cne $roleAnchorHash) { throw 'offline_role_or_stop_changed' }
    $roleFilesHash = HashText (RoleFileInventory)
    if ($journalAbsent) {
        # This is installer evidence of absence, not a synthesized native
        # offline-state reply and not an assertion that unknowns were cleared.
        Log 'journal_absent_after_original_exit' @{ path = $plan.RecoveryJournal; state = 'absent'; hash = $null; native_pending_read = $false }
    } else {
        $state = Admin $newExe '--offline-update-state'
        if (!$state.Stop.Stopped -or $state.Stop.UserSid -cne $plan.UserSid -or $state.Stop.Session -ne $plan.SessionId -or
            $state.JournalSha256 -cne $journalHash) { throw 'offline_stop_or_journal_changed' }
    }
    RequireNoActors
    $null = RequireRoleAnchor
    if ((RequireReleasedJournal -AllowMissing) -cne $journalHash) { throw 'offline_stop_or_journal_changed' }
    RequirePreviousTask
    if ((Hash (Join-Path $brokerRoot 'active.json')) -cne $plan.OldActiveSha256) { throw 'offline_active_changed' }
    $stage = 'publishing'
    $taskChanged = $true; RegisterTask $newXml $oldSddl
    $publishedTaskHash = HashText ([string](Export-ScheduledTask -TaskName $taskName -TaskPath '\'))
    Assert-FlowerTaskSecurity
    if ((HashText (Get-FlowerTaskSecurityDescriptor)) -cne $plan.OldTaskSddlSha256) { throw 'offline_new_task_sddl_changed' }
    $published = Get-FlowerTask
    if (@($published.Actions).Count -ne 1 -or $published.Actions.Execute -ine $newExe -or $published.Actions.Arguments -cne '--serve' -or
        $published.Actions.WorkingDirectory -ine $newDir -or [string]$published.Principal.RunLevel -notin @('Highest','HighestAvailable') -or
        [string]$published.Principal.LogonType -notin @('Interactive','InteractiveToken')) { throw 'offline_new_task_unconfirmed' }
    $activeChanged = $true; ReplaceActive (Join-Path $package 'active.json') $plan.ActiveSha256 $plan.OldActiveSha256
    $null = RequireRoleAnchor
    if ((RequireReleasedJournal -AllowMissing) -cne $journalHash) { throw 'offline_stop_or_journal_changed' }
    [FlowerPinnedDelivery]::CloseInputs()
    $guard.Dispose(); $guard = $null
    $stage = 'starting_paused'
    $startAttempted = $true
    Start-ScheduledTask -TaskName $taskName -TaskPath '\'
    # Broker RPC is checked separately from the real Codex connection. A local
    # human installer is not silently granted an AI-host identity for status.
    Log 'installed_paused_status_pending' @{ version = $version; journal_sha256 = $journalHash; stop = $closed }
    [IO.File]::WriteAllText(($prefix + '-result.json'), (@{ schema = 1; state = 'installed_paused_status_pending'; version = $version;
        operation = $plan.OperationId; resumed = $false; original_exit_code = 0; journal_sha256 = $journalHash } | ConvertTo-Json -Depth 8), $utf8)
    Write-Host '已换版并提交暂停启动。请回到 Codex 告知安装器已结束；接下来核对真实新服务和插件，不要手动恢复权限。'
    $completedSuccessfully = $true
} catch {
    $reason = $_.Exception.Message
    $recovery = 'inspection_required'
    try { $recovery = RecoverStoppedOriginal } catch { $recovery = 'recovery_unconfirmed:' + $_.Exception.Message }
    $completedSuccessfully = $false
    try { Log 'offline_migration_failed_no_resume' @{ reason = $reason; stage = $stage; task_changed = $taskChanged; active_changed = $activeChanged; recovery = $recovery } }
    catch { Write-Warning ('无法写入失败日志：' + $prefix) }
    if ($script:LoggingReady) {
      try {
        [IO.File]::WriteAllText(($prefix + '-result.json'), (@{ schema = 1; state = 'failed'; reason = $reason; stage = $stage;
            version = $version; operation = $plan.OperationId; task_changed = $taskChanged; active_changed = $activeChanged;
            resumed = $false; recovery = $recovery } | ConvertTo-Json -Depth 8), $utf8)
      } catch { Write-Warning ('无法写入失败回执：' + $prefix) }
    }
    Write-Error ('迁移未完成，保持现场，不要重放安装器：' + $reason) -ErrorAction Continue
    $completedSuccessfully = $false
} finally {
    try { if ($null -ne $guard) { $guard.Dispose() } }
    catch { $completedSuccessfully = $false; $cleanupErrors.Add('guard_dispose_failed'); Write-Warning '安装资源释放失败，请保留现场检查。' }
    try { if ('FlowerPinnedDelivery' -as [type]) { [FlowerPinnedDelivery]::Close() } }
    catch { $completedSuccessfully = $false; $cleanupErrors.Add('pinned_handles_close_failed'); Write-Warning '安装文件句柄释放失败，请保留现场检查。' }
}

# Preserve the installation result: cleanup failure is a separate fact.
if ($cleanupErrors.Count -gt 0) {
    $cleanup = @{ schema = 1; operation = $plan.OperationId; version = $version;
        state = 'cleanup_failed'; installation_result_preserved = $true; errors = @($cleanupErrors.ToArray()) }
    try { Log 'installation_cleanup_failed' $cleanup } catch { Write-Warning '无法记录资源释放错误日志。' }
    if ($script:LoggingReady) {
        try { [IO.File]::WriteAllText(($prefix + '-cleanup.json'), ($cleanup | ConvertTo-Json -Depth 4), $utf8) }
        catch { Write-Warning '无法写入单独的资源释放错误回执，请保留此窗口。' }
    }
}
# Release guarded resources before a person reads the completion dialog.
try { Add-Type -AssemblyName System.Windows.Forms; ShowOfflineMigrationResult $completedSuccessfully ($cleanupErrors.Count -gt 0) }
catch { Write-Warning ('安装结果对话框不可用；请保留此窗口核对错误和已有回执（早期失败可能尚无回执）：' + $prefix) }
if ($completedSuccessfully) { exit 0 } else { exit 1 }
